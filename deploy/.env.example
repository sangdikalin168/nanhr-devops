# Copy to deploy/.env on the server. Never commit the real .env.
REGISTRY=ghcr.io/sangdikalin168
IMAGE_TAG=latest
HTTP_PORT=8080

POSTGRES_USER=nanhr
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nanhr

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# Backups (scripts/backup-postgres.sh)
S3_BUCKET=s3://your-backup-bucket/nanhr
BACKUP_RETENTION_DAYS=14
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
